# Dependencies (reinstalled in Docker)
node_modules
vendor

# Local env and secrets (never ship real secrets in image)
.env
.env.local
.env.*.local
.env.backup

# Build artifacts that are re-generated
public/build
public/hot
storage/pail
storage/logs/*
storage/framework/cache/*
storage/framework/sessions/*
storage/framework/views/*

# Git and IDE
.git
.gitignore
.gitattributes
.idea
.vscode
*.md
design/
tests/
phpunit.xml

# OS / misc
.DS_Store
*.log
npm-debug.log*

# Docker build files themselves (not needed inside the image)
Dockerfile
.dockerignore

# Note: we do NOT ignore the docker/ directory because Dockerfile explicitly does
# COPY docker/entrypoint.sh ...  (required for the container to start)
# If you add more files from docker/ later (nginx, supervisord), they will be available.
